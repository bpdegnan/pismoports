# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               active_variants 1.1
# PismoPorts: no `PortGroup boost`. SciPy 1.15 vendors Boost.Math in
# subprojects/boost_math and has no option to use a system Boost (its
# meson.options offers only blas, lapack, use-g77-abi and use-pythran), so the
# dependency is vestigial -- and boost181 defaults to +python313, which would
# drag a second complete Python runtime into a tree pinned to 3.11.
PortGroup               compilers 1.0
PortGroup               compiler_blacklist_versions 1.0
PortGroup               python 1.0

name                    py-scipy
version                 1.15.2
revision                0

checksums               rmd160  07a89c025b97435948fc4c8cdd47ffc4ce37dbe5 \
                        sha256  cd58a314d92838f7e6f755c8a2167ead4f27e1fd5c1251fd54289569ef3495ec \
                        size    59417316

license                 BSD
maintainers             {michaelld @michaelld} {reneeotten @reneeotten} openmaintainer
description             An opensource library of scientific tools for Python
long_description        {*}${description}

homepage                https://www.scipy.org/

universal_variant       no

python.versions         39 310 311 312 313
python.pep517_backend   meson
python.add_archflags    no

if {${name} ne ${subport}} {
    compiler.c_standard 2017
    compiler.cxx_standard 2017

    # SciPy requires GCC >= 9.1
    compilers.setup     require_fortran -clang -gcc44 -gcc45 -gcc46 \
                        -gcc47 -gcc48 -gcc5 -gcc6 -gcc7 -gcc8 -g95

    # and Clang >= 12.0
    compiler.blacklist-append {clang < 1200}

    patchfiles-append   patch-version-caps-pyproject.toml.diff \
                        patch_scipy_meson.build.diff

    if {${os.platform} eq "darwin" && [string match *gcc* ${configure.compiler}]} {
        # dfitpackmodule.c: error: passing argument 1 of 'f2py_func'
        # from incompatible pointer type [-Wincompatible-pointer-types]
        patchfiles-append \
                        0001-patch-extra-flags.patch
    }
    if {${os.platform} eq "darwin" && ${os.major} < 11} {
        # Use legacysupport for strnlen, but for select sources.
        # Adding portgroup breaks the build: https://trac.macports.org/ticket/71272
        depends_lib-append \
                        path:lib/libMacportsLegacySupport.dylib:legacy-support
        patchfiles-append \
                        0002-Use-legacysupport-manually-for-strnlen.patch
        post-patch {
            reinplace "s|@PREFIX@|${prefix}|g" ${worksrcpath}/scipy/io/meson.build \
                        ${worksrcpath}/scipy/optimize/meson.build \
                        ${worksrcpath}/scipy/sparse/linalg/_eigen/arpack/meson.build \
                        ${worksrcpath}/scipy/sparse/linalg/_propack/meson.build
        }
    }

    if {${python.version} == 39} {
        version         1.13.1
        revision        0
        checksums       rmd160  ab376ae8d339135b8edb8220d28c26fb495a0609 \
                        sha256  095a87a0312b08dfd6a6155cbbd310a8c51800fc931b8c0b84003014b874ed3c \
                        size    57210720
        patchfiles-replace \
                        patch-version-caps-pyproject.toml.diff \
                        patch-v1.13.1-version-caps-pyproject.toml.diff

        patchfiles-delete \
                        patch_scipy_meson.build.diff
    }

    configure.fflags-append -fno-second-underscore

    depends_build-append \
                        port:py${python.version}-cython \
                        path:bin/pkg-config:pkgconfig

    # PismoPorts: Pythran off. Its generated C++ is built on xsimd, a SIMD
    # abstraction that selects AltiVec when the compiler offers it -- G4 code
    # in a G3 tree, the failure that already hit iverilog and that OpenBLAS
    # would bring in. use-pythran=false is an upstream build option; the
    # affected routines fall back to their Cython or pure-Python versions.
    # It also drops py-pythran, py-gast, py-beniget and py-ply.
    build.args-append   -Csetup-args=-Duse-pythran=false

    build.env-append    PATH=${python.prefix}/bin:$env(PATH)

    # PismoPorts: py-mypy is not carried over. Nothing in SciPy imports it at
    # run time, and here it would add mypy and its typeshed stub packages for
    # no function.
    depends_lib-append  port:py${python.version}-numpy \
                        port:py${python.version}-pybind11

    # SciPy (and NumPy) only support the Accelerate framework for macOS 13.3+
    # see: https://scipy.github.io/devdocs/building/blas_lapack.html
    if {${os.platform} eq "darwin" && (${os.major} > 22 || ${os.major} == 22 && ${os.minor} >= 4)} {
        variant accelerate conflicts openblas flexiblas blis netlib description "Use Apples Accelerate Framework" {
            build.args-append -Csetup-args=-Dblas=accelerate -Csetup-args=-Dlapack=accelerate
        }
    }

    variant openblas conflicts accelerate flexiblas blis netlib description "Use MacPorts OpenBLAS Libraries" {
        depends_lib-append  path:lib/libopenblas.dylib:OpenBLAS

        build.args-append -Csetup-args=-Dblas=openblas -Csetup-args=-Dlapack=openblas \
                          -Csetup-args=-Dpkg_config_path=${prefix}/lib/pkgconfig
    }

    variant flexiblas conflicts accelerate openblas blis netlib description "Use MacPorts FlexiBLAS libraries" {
        depends_lib-append  port:flexiblas

        build.args-append -Csetup-args=-Dblas=flexiblas -Csetup-args=-Dlapack=flexiblas \
                          -Csetup-args=-Dpkg_config_path=${prefix}/lib/pkgconfig
    }

    variant blis conflicts accelerate openblas flexiblas netlib description "Use MacPorts BLIS/lapack libraries" {
        # TODO: eventually this could/should use libFLAME, but currently SciPy cannot be convinced to use it
        depends_lib-append  port:blis \
                            port:lapack

        build.args-append -Csetup-args=-Dblas=blis -Csetup-args=-Dlapack=lapack \
                          -Csetup-args=-Dpkg_config_path=${prefix}/share/pkgconfig:${prefix}/lib/lapack/pkgconfig
    }

    # PismoPorts: netlib's reference BLAS and LAPACK, from math/lapack.
    #
    # SciPy cannot use numpy's bundled lapack_lite (see python/py-numpy
    # +noblas): it is private to numpy. It needs an installed BLAS/LAPACK, and
    # upstream defaults to OpenBLAS below 13.3, whose PowerPC kernels are
    # AltiVec -- G4 code a G3 cannot run. math/lapack's default build is the
    # plain reference Fortran (BLAS, CBLAS, LAPACK, LAPACKE) with no vector
    # code, installing blas.pc and lapack.pc under lib/lapack/pkgconfig -- the
    # same directory the blis variant above already points meson at.
    # Slow, but every instruction is one a 750 has.
    variant netlib conflicts accelerate openblas flexiblas blis description "Use netlib reference BLAS/LAPACK (safe on G3)" {
        depends_lib-append  port:lapack

        build.args-append -Csetup-args=-Dblas=blas -Csetup-args=-Dlapack=lapack \
                          -Csetup-args=-Dpkg_config_path=${prefix}/lib/lapack/pkgconfig
    }

    # set default BLAS/LAPACK variant if none is explicitly selected by the user
    if {![variant_isset accelerate] && ![variant_isset openblas] && ![variant_isset flexiblas] && ![variant_isset blis] && ![variant_isset netlib]} {
        # default to macOS Accelerate framework if macOS 13.3 or higher, otherwise OpenBLAS
        if {${os.platform} eq "darwin" && (${os.major} > 22 || ${os.major} == 22 && ${os.minor} >= 4) && ${python.version} > 39} {
            default_variants +accelerate
        } elseif {${os.arch} eq "powerpc"} {
            # os.arch, not build_arch -- see the same note in python/py-numpy
            default_variants +netlib
        } else {
            default_variants +openblas
        }
    }

    test.run            yes
    test.dir            ${destroot}${python.pkgd}
    test.env-append     PYTHONPATH=${destroot}${python.pkgd}

    depends_test-append port:py${python.version}-hypothesis \
                        port:py${python.version}-pooch \
                        port:py${python.version}-mpmath \
                        port:py${python.version}-gmpy2 \
                        port:py${python.version}-threadpoolctl \
                        port:py${python.version}-scikit-umfpack
}
