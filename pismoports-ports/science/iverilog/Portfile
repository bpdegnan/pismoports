                        port:autoconf \
                        port:gperf

use_autoconf        yes

# configure.ac:17 calls AX_PROG_CC_FOR_BUILD, which probes for a compiler to
# run on the BUILD machine. It is not a cross build, but the macro does its
# own AC_PROG_CC with the environment reset, so it picks bare `gcc` off PATH
# -- Tiger's /usr/bin/gcc 4.0 -- rather than the gcc14 MacPorts selected:
#
#   configure:5320: gcc -std=gnu23 -g -O2 conftest.c
#   cc1: error: unrecognized command line option "-std=gnu23"
#   configure:5372: error: C compiler cannot create executables
#
# The -std=gnu23 probe comes from regenerating configure with our autoconf
# 2.73 (use_autoconf yes above); the shipped configure predates it. So this
# needs BOTH an ancient system compiler and a modern autoconf, which is why
# it shows up here and nowhere upstream tests.
#
# "cannot create executables" is misleading -- the MacPorts compiler links
# fine, and config.log shows its conftest at :3840 returning 0 and the binary
# running. Only the second, build-machine probe fails.
#
# AX_PROG_CC_FOR_BUILD honours these from the environment. Verified by running
# the real configure by hand with them set: rc=0, all config headers written.
#
# This MUST be in pre-configure, not at the top level. ${configure.cc} read
# while the Portfile is being parsed gives the DEFAULT compiler, before
# compiler.cxx_standard 2011 above has blacklisted it and promoted the choice
# to gcc14. Setting it at top level produced exactly that, from the log:
#
#   CC='/opt/local/bin/gcc-mp-14'                 <- real selection
#   CC_FOR_BUILD='/opt/local/bin/gcc-apple-4.2'   <- stale, parse-time value
#
# and apple-gcc-4.2 does not know -std=gnu23 either, so the build failed
# identically and looked like the fix had not worked at all.
pre-configure {
    configure.env-append    CC_FOR_BUILD=${configure.cc} \
                            CXX_FOR_BUILD=${configure.cxx}

    # The libvvp.so rule that patch-vvp-Makefile.in.diff touches reads
    # $(LDFLAGS) but NOT $(CXXFLAGS):
    #
    #     $(CXX) -shared $(LDFLAGS) -install_name ... -o libvvp.so $O ...
    #
    # and -arch ppc lives in CXXFLAGS, so that one link alone was built for
    # gcc14's default target instead of this machine:
    #
    #     otool -h libvvp.so  ->  cputype 18  cpusubtype 10   (= PowerPC 7400)
    #
    # A G3 cannot execute G4 code, so every binary linking it died at launch
    # with "dyld: incompatible cpu-subtype" (rc=133) -- after a completely
    # clean build, which is what makes it easy to miss. The executables were
    # fine; only the shared library was wrong.
    #
    # Putting the arch flag in LDFLAGS reaches that rule. It duplicates
    # -arch ppc on the links that already had it via CXXFLAGS, which is
    # harmless. Same reason this is in pre-configure as the vars above:
    # read at parse time the value is not final.
    configure.ldflags-append {*}${configure.ld_archflags}
}

# vvp/Makefile.in:151 uses else-if chaining:
#
#     else ifeq (@LIBVVP@,yes)
#
# which arrived in GNU Make 3.81. Tiger's /usr/bin/make is 3.80, from 2002, so
# it reads the `else', treats the `ifeq' as junk after it, and then trips over
# the genuine `else' further down:
#
#     vvp/Makefile:151: Extraneous text after `else' directive
#     vvp/Makefile:163: *** only one `else' per conditional.  Stop.
#
# Note this is reached ONLY with --enable-libvvp below; the chain exists to
# pick the libvvp build. Same 3.80 limitation that games/bsd-games hits, and
# the same answer: build with MacPorts' gmake rather than patch the Makefile.
depends_build-append    port:gmake
build.cmd               ${prefix}/bin/gmake

configure.args-append --enable-libvvp
configure.ldflags-append -Wl,-rpath,${prefix}/lib

patchfiles-append patch-vvp-Makefile.in.diff

# main.c:1065:17: error: implicit declaration of function '_NSGetExecutablePath' [-Wimplicit-function-declaration]
patchfiles-append patch-fix-headers.diff

platform darwin {
    #under MacOS, this is needed, the library references were incorrect as-is
    configure.cxxflags-append -fPIC
}

compiler.cxx_standard 2011

if {[string match *clang* ${configure.cxx}] && ${configure.cxx_stdlib} ne ""} {
    configure.ldflags-append -stdlib=${configure.cxx_stdlib}
}

test.run            yes
test.target         check

destroot.destdir    prefix=${destroot}${prefix}

post-destroot {
    if {[file exists ${destroot}${prefix}/lib/libvvp.so]} {
        # Fix just the library's install name
        system "install_name_tool -id ${prefix}/lib/libvvp.so ${destroot}${prefix}/lib/libvvp.so"
    }
}

# g++-4.2: -E, -S, -save-temps and -M options are not allowed with multiple -arch flags
universal_variant   no

subport ${name}-docs {
    description         Documentation for Icarus Verilog
    long_description    This subport provides the documentation for Icarus Verilog, \
                        including user guides and API references.

    # Python 3.11, not 3.12: this tree carries lang/python311 and has no
    # python312, so asking for py312-sphinx would drag in a second complete
    # Python runtime purely to render HTML. py-sphinx lists 311 in its
    # python.versions, so this is a supported combination upstream.
    #
    # `port:sphinx` is deliberately NOT carried over from upstream. That is
    # textproc/sphinx -- the Sphinx FULL-TEXT SEARCH ENGINE from
    # sphinxsearch.com, version 2.2.11 -- which shares a name with the
    # documentation generator and has nothing to do with it. It installs no
    # sphinx-build. Depending on it builds a search server for no reason.
    depends_build-append       port:py311-sphinx

    worksrcdir          ${github.project}-${github.version}

    pre-build {
        reinplace "s|sphinx-build|sphinx-build-3.11|" ${worksrcpath}/Documentation/Makefile
    }

    build {
        system -W ${worksrcpath}/Documentation "make html"
    }

    destroot {
        set docdir ${destroot}${prefix}/share/doc/${name}
        xinstall -d ${docdir}
        system "cp -R ${worksrcpath}/Documentation/_build/html/* ${docdir}/"
    }

    depends_lib
}
