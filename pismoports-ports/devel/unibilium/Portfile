PortSystem 1.0
PortGroup github 1.0

github.setup        neovim unibilium 2.1.2 v
github.tarball_from archive
revision            1
categories          devel
maintainers         nomaintainer
license             LGPL-3+

description         A terminfo parsing library
  
long_description \
    Unibilium is a very basic terminfo library. It doesn't depend on curses or \
    any other library. It also doesn't use global variables, so it should be \
    thread-safe.

checksums           rmd160  b7b07c50bfb02bb8fdeded98d7b646cc4e7293eb \
                    sha256  370ecb07fbbc20d91d1b350c55f1c806b06bf86797e164081ccc977fc9b3af7a \
                    size    122525

depends_build       port:libtool


use_autoreconf      yes
build.args          TERMINFO_DIRS="\\"/etc/terminfo:${prefix}/share/terminfo:/usr/local/share/terminfo:/usr/share/terminfo\\""

test.run            yes


platform darwin 8 {
   #added for 10.4 support
   depends_build-append port:ncurses

   # Build the library, man pages and tools, but NOT the test fixtures.
   #
   # Makefile:69 is "all: $(LIBRARY) build-man build-tools build-test", and
   # build-test generates C source from live terminfo entries:
   #
   #   tools/gen-static-test screen-256color > t/static_screen-256color.c
   #   unibi_from_term("screen-256color"): Invalid argument
   #   make: *** [t/static_screen-256color.c] Error 1
   #
   # screen-256color postdates Tiger and is in neither /usr/share/terminfo nor
   # MacPorts' own terminfo, so the fixture cannot be generated. Nothing ships
   # from it -- libunibilium.4.dylib links successfully before this point, and
   # the failure is purely in the test tree. Rewriting the target rather than
   # naming the pieces explicitly keeps $(LIBRARY) expanding as upstream
   # intends.
   post-patch {
       reinplace {s|^all: .*|all: $(LIBRARY) build-man build-tools|} \
           ${worksrcpath}/Makefile
   }

   # ...and with no test fixtures there is nothing for the test phase to run.
   test.run             no
   depends_lib-append  port:ncurses
   build.env-append TERMINFO_DIRS=${prefix}/share/terminfo TERMINFO=${prefix}/share/terminfo

   configure.ldflags-delete -Wl,-dead_strip -dead_strip
   build.env-append LDFLAGS="-Wl,-e,_main"
}