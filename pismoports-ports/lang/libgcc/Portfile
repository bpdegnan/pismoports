# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           gcc_dependency 1.0
PortGroup           select 1.0

epoch               3
name                libgcc
version             10.0
revision            1

conflicts           libgcc-devel

categories          lang
maintainers         nomaintainer

distfiles

use_configure       no

description         Provides the appropriate gcc runtime.
long_description    {*}${description} \
                    Picks the version to use based on macOS version.

license             BSD
platforms           any

homepage            https://www.macports.org

variant universal   { }

# Pick the gcc version that provides the primary runtime.
# NOTE: The logic here must match that in the gccX ports *and*
# that in _resources/port1.0/group/compilers-1.0.tcl
#
# 14, not 16. gcc14 is the only compiler this tree installs, and it configures
# with --disable-tls (Darwin 8 has no native TLS), so its libstdc++ headers use
# the legacy std::call_once -- the one calling __once_functor,
# __get_once_mutex and __set_once_functor_lock_ptr. lang/gcc16 drops
# --disable-tls on purpose, so libgcc16's libstdc++ exported only the
# emulated-TLS symbols and none of the legacy ones. Compiler and runtime
# disagreed and every C++ port touching std::call_once failed to link, which
# is what killed icu and behind it poppler, texlive-bin and ngspice.
# compilers-1.0.tcl already stops at 14, so this restores the consistency the
# NOTE above asks for.
set gcc_version     14

depends_lib         port:libgcc${gcc_version}

build { }

destroot {
   xinstall -d ${destroot}${prefix}/share/doc/${name}
   system "echo 'libgcc runtime is provided by libgcc${gcc_version}' > ${destroot}${prefix}/share/doc/${name}/README"
}
