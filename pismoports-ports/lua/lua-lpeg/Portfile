description         Parsing Expression Grammars For Lua
long_description    {*}${description}.

checksums           rmd160  a65963eb89256fde3b79e6473a43c356c2fea3e4 \
                    sha256  6637fcf4d3ddef7be490a2f0155bd2dcd053272d1bb78c015498709ef9fa75dd \
                    size    78933

luarocks.worksrcdir lpeg-${version}
luarocks.uploader   gvvaughan

patchfiles          patch-makefile-add-dylib.diff

platform darwin 8 {
    # lpeg's makefile hands the compiler -Wc++-compat, which arrived in GCC
    # 4.3. The build here uses apple-gcc-4.2, so:
    #
    #   cc1: error: unrecognized command line option "-Wc++-compat"
    #   make: *** [lpvm.o] Error 1
    #
    # It is a warning switch and nothing else -- it asks the C compiler to
    # flag constructs a C++ compiler would reject. Dropping it changes no
    # generated code. Preferred over forcing gcc14 for this one small C
    # module, which would compile it with a different toolchain from the lua51
    # it loads into for no benefit.
    post-patch {
        reinplace {s|-Wc++-compat||g} ${worksrcpath}/makefile
    }
}

post-build {
    system -W ${worksrcpath} "make PREFIX=${prefix} LUADIR=${prefix}/include/lua${lua.version} lpeg.dylib"
}

post-destroot {
    xinstall -m 0755 ${worksrcpath}/lpeg.dylib \
        ${destroot}${prefix}/lib/lua/${lua.version}/lpeg.dylib
}
