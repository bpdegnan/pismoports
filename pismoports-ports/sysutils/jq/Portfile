PortSystem          1.0
PortGroup           github 1.0
PortGroup           legacysupport 1.1

# realpath(path, NULL). Every jq invocation that compiles a program walks the
# module search path through jq_realpath() (src/util.c), which sizes its buffer
# with pathconf(path, _PC_PATH_MAX) -- and pathconf fails on a path that does
# not exist, such as the default ~/.jq, leaving buf NULL. jq then relies on
# realpath() allocating the result itself, which is POSIX.1-2008 behaviour
# Mac OS X only gained in 10.6. Tiger's realpath writes through the NULL:
#
#     Thread 0 Crashed:  realpath + 124  <-  jq_realpath  <-  find_lib
#     EXC_BAD_ACCESS  KERN_PROTECTION_FAILURE at 0x00000000      (rc 138)
#
# so `jq --version` works and `jq .` on anything does not. legacy-support
# exports a realpath that allocates when given NULL (REALPATH_ALLOC, < 10.6).
legacysupport.newest_darwin_requires_legacy 9

github.setup        jqlang jq 1.7.1 jq-
github.tarball_from releases
revision            2

categories          sysutils
license             MIT
maintainers         {gmail.com:herby.gillot @herbygillot} \
                    openmaintainer

description         A lightweight and flexible command-line JSON processor
long_description\
    jq is like sed for JSON data – you can use it to slice and filter and \
    map and transform structured data with the same ease that sed, awk, \
    grep and friends let you play with text.

homepage            https://jqlang.github.io/jq/

checksums           rmd160  847594ee8355e6ddd047e31e72b0e6ac6397494f \
                    sha256  478c9ca129fd2e3443fe27314b455e211e0d8c60bc8ff7df703873deeee580c2 \
                    size    1950645

depends_lib-append  port:oniguruma6

# The documentation requires some ruby dependencies which are not available as
# ports. However, the manpage is already distributed in compiled form and will
# be installed.
configure.args      --disable-docs \
                    --disable-silent-rules \
                    --with-oniguruma=${prefix} \
                    --disable-maintainer-mode

livecheck.type      regex
livecheck.regex     ${name}-(\\d+(\.\\d+)+)\.tar

test.run            yes
test.target         check
