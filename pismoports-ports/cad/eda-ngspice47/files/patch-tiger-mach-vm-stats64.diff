--- src/frontend/get_avail_mem_size.c
+++ src/frontend/get_avail_mem_size.c
@@ -68,6 +68,23 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <sys/sysctl.h>
+
+/* The 64-bit Mach VM statistics API -- host_statistics64(), HOST_VM_INFO64,
+ * vm_statistics64_data_t and host_info64_t -- arrives in Mac OS X 10.6.
+ * Tiger has only the 32-bit forms, so map onto those. free_count and
+ * inactive_count are natural_t rather than 64-bit there, but both are already
+ * cast to uint64_t where they are used below, so the arithmetic is unchanged.
+ * Same idiom and the same MAC_OS_X_VERSION_MAX_ALLOWED guard as this port's
+ * patch-ngspice-older-MACH-defines.diff.
+ */
+#include <AvailabilityMacros.h>
+#if MAC_OS_X_VERSION_MAX_ALLOWED < 1060
+#  define HOST_VM_INFO64_COUNT   HOST_VM_INFO_COUNT
+#  define vm_statistics64_data_t vm_statistics_data_t
+#  define host_statistics64      host_statistics
+#  define HOST_VM_INFO64         HOST_VM_INFO
+#  define host_info64_t          host_info_t
+#endif
 #include <mach/mach.h>
 
     mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
