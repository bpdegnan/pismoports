# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                bsd-games
version             3.3
revision            4
categories          games
license             BSD
maintainers         {makr @mohd-akram} openmaintainer

description         Classic text mode games from UNIX folklore

long_description    {*}${description}

homepage            https://bsd-games.sourceforge.net

master_sites        sourceforge

checksums           rmd160  50703d26b0b9bb8135c1ed0d6ceea91f91c7109d \
                    sha256  78bfdf7f4e1f61ed42ad1209ef52520b89a583bd511e9606b8162f813078048d \
                    size    268373

depends_build       port:pkgconfig

depends_lib         port:ncurses

post-patch {
    reinplace \
        "s|snprintf\[\[:space:]]*(ArrayBlock\[\[:space:]]*(\\(\[^)]*\\))|snprintf(\\1, ArraySize(\\1)|g" \
        {*}[glob ${worksrcpath}/*/*.c]
    reinplace "s|/var/|${prefix}/var/|g" {*}[glob ${worksrcpath}/*/*.6]
}

configure.args      --localstatedir=${prefix}/var/lib

# TWO separate reasons this fails on Tiger, both ending in the same message:
#
#   mkdir: .o: No such file or directory
#   make: *** [.o/adventure/.d] Error 1
#
# 1. Config.mk puts every object under `builddir := ${TMPDIR}/make/${name}` and
#    symlinks .o to it. MacPorts scrubs TMPDIR from the build environment, so
#    builddir collapsed to /make/bsd-games and could not be created. Upstream
#    never sees this because launchd sets a per-user TMPDIR on the macOS
#    versions they build on. Fixed by pointing builddir somewhere real.
#
# 2. Tiger's /usr/bin/make is GNU Make 3.80, from 2002. $(abspath) arrived in
#    3.81, so the Makefile's
#
#        oname := $(notdir $(abspath $O))
#
#    expands to the EMPTY STRING, and the recipe that creates the .o symlink
#
#        @[ -h ${oname} ] || ln -sf ${builddir} ${oname}
#
#    becomes `[ -h ] || ...`. A one-argument [ tests that the string "-h" is
#    non-empty, which is true, so the || never fires and the symlink is never
#    made. Nothing reports an error -- the next rule just cannot find .o.
#
#    Fixing (1) alone is not enough; that was tried first and failed
#    identically. Build with MacPorts' gmake 4.4.1 instead of patching around
#    a 23-year-old make, since this Makefile expects a modern one throughout.
depends_build-append    port:gmake
build.cmd               ${prefix}/bin/gmake

# 3. Config.mk asks for C11 unconditionally:
#
#        cflags += -std=c11 -D_APPLE_C_SOURCE -DNCURSES_WIDECHAR ${CFLAGS}
#
#    but MacPorts picks apple-gcc-4.2 here, which is from 2007 and answers
#
#        cc1: error: unrecognized command line option "-std=c11"
#
#    Declaring the standard is what moves the port onto gcc14, rather than
#    patching the flag out of a build system that means it. Same mechanism as
#    editors/neovim in this tree.
compiler.c_standard     2011

set objdir          ${workpath}/objdir
build.args-append   builddir=${objdir}
destroot.args       INSTALL_SCORE=: builddir=${objdir}
destroot.keepdirs   ${destroot}${prefix}/var/lib/bsdgames

post-activate {
    foreach {game} {adventure atc battlestar drop4 robots snake spirhunt} {
        set scores ${prefix}/var/lib/bsdgames/${game}.scores
        if {![file exists ${scores}]} {
            xinstall -m 664 -g everyone /dev/null ${scores}
        }
    }
}
