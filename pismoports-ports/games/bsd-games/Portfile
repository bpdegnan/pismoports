# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

# Tiger fix, one of six; the rest are commented further down, next to the
# settings they justify. Nothing is wrong with this software -- every one of
# the six is an assumption its build makes about the environment that only
# fails on a 2005 OS.
#
#    common/util.c calls clock_gettime(CLOCK_REALTIME, ...), which macOS did
#    not have until 10.12 -- Tiger's time.h and sys/time.h do not mention it
#    at all, so gcc14 stops on the implicit declaration and on an undeclared
#    CLOCK_REALTIME. legacysupport supplies both (see
#    ${prefix}/include/LegacySupport/time.h, which defines CLOCK_REALTIME and
#    declares clock_gettime), which is cheaper and less fragile than patching
#    the call sites over to gettimeofday.
PortGroup           legacysupport 1.1

name                bsd-games
version             3.3
revision            7
categories          games
license             BSD
maintainers         {makr @mohd-akram} openmaintainer

description         Classic text mode games from UNIX folklore

long_description    {*}${description}

homepage            https://bsd-games.sourceforge.net

master_sites        sourceforge

checksums           rmd160  50703d26b0b9bb8135c1ed0d6ceea91f91c7109d \
                    sha256  78bfdf7f4e1f61ed42ad1209ef52520b89a583bd511e9606b8162f813078048d \
                    size    268373

depends_build       port:pkgconfig

depends_lib         port:ncurses

post-patch {
    reinplace \
        "s|snprintf\[\[:space:]]*(ArrayBlock\[\[:space:]]*(\\(\[^)]*\\))|snprintf(\\1, ArraySize(\\1)|g" \
        {*}[glob ${worksrcpath}/*/*.c]
    reinplace "s|/var/|${prefix}/var/|g" {*}[glob ${worksrcpath}/*/*.6]

    # See note 4 below. This lives INSIDE the existing post-patch on purpose:
    # a second `post-patch` block would replace this one rather than add to
    # it, silently dropping the two reinplaces above.
    if {${os.platform} eq "darwin" && ${os.major} <= 8} {
        reinplace {/#define _POSIX_C_SOURCE/d} ${worksrcpath}/common/common.h
    }
}

configure.args      --localstatedir=${prefix}/var/lib

# TWO separate reasons this fails on Tiger, both ending in the same message:
#
#   mkdir: .o: No such file or directory
#   make: *** [.o/adventure/.d] Error 1
#
# 1. Config.mk puts every object under `builddir := ${TMPDIR}/make/${name}` and
#    symlinks .o to it. MacPorts scrubs TMPDIR from the build environment, so
#    builddir collapsed to /make/bsd-games and could not be created. Upstream
#    never sees this because launchd sets a per-user TMPDIR on the macOS
#    versions they build on. Fixed by pointing builddir somewhere real.
#
# 2. Tiger's /usr/bin/make is GNU Make 3.80, from 2002. $(abspath) arrived in
#    3.81, so the Makefile's
#
#        oname := $(notdir $(abspath $O))
#
#    expands to the EMPTY STRING, and the recipe that creates the .o symlink
#
#        @[ -h ${oname} ] || ln -sf ${builddir} ${oname}
#
#    becomes `[ -h ] || ...`. A one-argument [ tests that the string "-h" is
#    non-empty, which is true, so the || never fires and the symlink is never
#    made. Nothing reports an error -- the next rule just cannot find .o.
#
#    Fixing (1) alone is not enough; that was tried first and failed
#    identically. Build with MacPorts' gmake 4.4.1 instead of patching around
#    a 23-year-old make, since this Makefile expects a modern one throughout.
depends_build-append    port:gmake
build.cmd               ${prefix}/bin/gmake

# 3. Config.mk asks for C11 unconditionally:
#
#        cflags += -std=c11 -D_APPLE_C_SOURCE -DNCURSES_WIDECHAR ${CFLAGS}
#
#    but MacPorts picks apple-gcc-4.2 here, which is from 2007 and answers
#
#        cc1: error: unrecognized command line option "-std=c11"
#
#    Declaring the standard is what moves the port onto gcc14, rather than
#    patching the flag out of a build system that means it. Same mechanism as
#    editors/neovim in this tree.
compiler.c_standard     2011

# 4. common/common.h opens with
#
#        #define _GNU_SOURCE
#        #define _POSIX_C_SOURCE 200809L
#
#    and Tiger's /usr/include/signal.h guards psignal with a bare
#
#        #ifndef _POSIX_C_SOURCE
#        void psignal(unsigned int, const char *);
#
#    so the declaration vanishes and gcc14, which makes implicit declarations
#    an error, stops on adventure/advent.c:123.
#
#    Later macOS writes that guard as
#        #if !defined(_POSIX_C_SOURCE) || defined(_DARWIN_C_SOURCE)
#    which is why -D_DARWIN_C_SOURCE is the usual answer and why it does NOT
#    work here -- Tiger's guard cannot be re-opened once the macro is set, so
#    the define itself has to go. Not defining it is safe on Darwin: the
#    default namespace is a superset of POSIX, so this exposes more, not less.
#
#    Verified by deleting the line in a build tree and recompiling advent.c:
#    clean, object file produced.
#
#    The reinplace that does this is up in the post-patch block above, not
#    here, because a second post-patch would have replaced that one.

# The legacysupport PortGroup puts -lMacportsLegacySupport into LDFLAGS, and
# Config.mk does honour that:
#
#     ldflags += -L/opt/local/lib -Wl,-search_paths_first ${LDFLAGS}
#
# but the libraries for the final link come from `libs`, not ldflags, so the
# header declared clock_gettime, everything compiled, and the link then failed:
#
#     Undefined symbols: "_clock_gettime", referenced from:
#         _srandrand in libcommon.a(util.o)
#
# Restating -lncurses is required, not decorative: a command-line assignment
# REPLACES the Makefile's `libs := -lncurses` rather than adding to it. Same
# trap as TARGET_XLIBS in lang/luajit.
#
# Verified by hand before setting it -- relinking .o/adventure/*.o against
# -lncurses -lMacportsLegacySupport produced a working binary.
build.args-append   libs="-lncurses -lMacportsLegacySupport"

set objdir          ${workpath}/objdir
build.args-append   builddir=${objdir}
destroot.args       INSTALL_SCORE=: builddir=${objdir}
destroot.keepdirs   ${destroot}${prefix}/var/lib/bsdgames

post-activate {
    foreach {game} {adventure atc battlestar drop4 robots snake spirhunt} {
        set scores ${prefix}/var/lib/bsdgames/${game}.scores
        if {![file exists ${scores}]} {
            xinstall -m 664 -g everyone /dev/null ${scores}
        }
    }
}
